# ====== SERVER ======
PORT=3000
NODE_ENV=production
APP_URL=https://exyudating.com

# ====== BAZA (PostgreSQL) ======
# Ako koristiš MySQL umjesto Postgresa, javi - promijenit ćemo db.js drajver.
DATABASE_URL=postgres://exyu_user:promijeni_lozinku@localhost:5432/exyu_dating

# ====== JWT / SESIJE ======
# Generiraj dugačak nasumičan string, npr: openssl rand -hex 64
JWT_SECRET=promijeni_ovo_u_dugacak_nasumican_string
JWT_EXPIRES_IN=30d
COOKIE_NAME=exyu_session

# ====== ADMIN (koristi se SAMO za seed skriptu, nikad u frontend kodu) ======
ADMIN_NICK=marko
ADMIN_EMAIL=admin@exyudating.com
ADMIN_PASSWORD=promijeni_ovo_u_jaku_lozinku

# ====== EMAIL (SMTP - npr. preko Zoho, Gmail App Password, ili SendGrid SMTP relay) ======
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USER=exyu.upoznavanje@gmail.com
SMTP_PASS=app_password_ovdje
SMTP_FROM="EX YU DATING <exyu.upoznavanje@gmail.com>"

# ====== SMS (Twilio - ili zamijeni s drugim providerom, npr. Infobip za lokalne brojeve) ======
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ====== RATE LIMITING ======
FORGOT_PASSWORD_MAX_ATTEMPTS=3
FORGOT_PASSWORD_BLOCK_MINUTES=15

# ====== NAPLATA (Stripe) - OSTAVI PRAZNO dok ne budeš spreman/na naplaćivati ======
# Kad se odlučiš aktivirati, vidi upute u src/services/payments.js
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
